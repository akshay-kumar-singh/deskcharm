# The app as built by ./build.sh, and its scratch folder (also used by ./test.sh).
# It's shared through the DeskCharm.dmg on GitHub Releases instead.
DeskCharm.app/
build/

# Installed packages and build output of the website (npm install / npm run build)
node_modules/
site/dist/

# The Windows app's built pages and installer (npm run build / npm run dist in windows/).
# The installer is shared through DeskCharm-Setup.exe on GitHub Releases instead.
windows/dist/
windows/release/

# Secrets: keys and passwords stay on this Mac
.env
.env.*

# Finder's per-folder view settings, rewritten whenever a folder is opened
.DS_Store
